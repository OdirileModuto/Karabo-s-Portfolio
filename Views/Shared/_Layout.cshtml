<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Karabo Moduto | Full Stack &amp; Integration Developer</title>
    <meta name="description" content="Karabo Moduto - Full Stack & Integration Developer based in Midrand, South Africa. Specialising in scalable applications, backend services, APIs, enterprise integrations and automation." />
    <meta name="theme-color" content="#0A0E14" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Karabo Moduto - Full Stack & Integration Developer" />
    <meta property="og:description" content="Building scalable applications, powerful integrations and intelligent digital solutions." />
    <meta property="og:image" content="/img/og-cover.png" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-nav" id="siteNav">
        <div class="nav-inner">
            <a href="#top" class="nav-brand">KM<span class="nav-brand-dot">.</span></a>
            <nav class="nav-links" id="navLinks" aria-label="Primary">
                <a href="#about">About</a>
                <a href="#skills">Skills</a>
                <a href="#projects">Projects</a>
                <a href="#experience">Experience</a>
                <a href="#certifications">Certifications</a>
                <a href="#contact" class="nav-cta">Contact</a>
            </nav>
            <button class="nav-toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="navLinks">
                <span></span><span></span><span></span>
            </button>
        </div>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <div class="footer-brand">
                <span class="footer-name">Karabo Moduto</span>
                <span class="footer-role">Full Stack &amp; Integration Developer</span>
            </div>
            <nav class="footer-links" aria-label="Footer">
                <a href="#about">About</a>
                <a href="#skills">Skills</a>
                <a href="#projects">Projects</a>
                <a href="#experience">Experience</a>
                <a href="#certifications">Certifications</a>
                <a href="#contact">Contact</a>
            </nav>
            <div class="footer-social">
                <a href="https://github.com/" target="_blank" rel="noopener" aria-label="GitHub">GitHub</a>
                <a href="https://linkedin.com/" target="_blank" rel="noopener" aria-label="LinkedIn">LinkedIn</a>
                <a href="mailto:ko.moduto@gmail.com" aria-label="Email">Email</a>
            </div>
        </div>
        <p class="footer-copy">&copy; 2026 Karabo Moduto. Built with ASP.NET Core.</p>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
